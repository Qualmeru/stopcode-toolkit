# Normalise line endings so a clone behaves the same regardless of the
# cloner's core.autocrlf setting.

# Default: store LF in the repository, check out native line endings.
* text=auto

# Windows-only files that should always arrive with CRLF. Batch files in
# particular can misbehave with LF endings.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.reg   text eol=crlf

# Cross-platform text: LF.
*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

# Binary: never convert, never diff as text.
*.ico   binary
*.png   binary
*.dmp   binary
